# ── Canal 1: Telegram ────────────────────────────────────────────────────
# Crie o bot com o @BotFather no Telegram e cole o token aqui
TELEGRAM_BOT_TOKEN=

# ── Canal 2: WhatsApp Cloud API (fase 3) ─────────────────────────────────
# Passo a passo de onde tirar CADA valor: docs/whatsapp-fase3.md.
# Os quatro primeiros andam JUNTOS: com todos preenchidos o canal sobe; todos
# vazios, o bot roda só no Telegram. Meia configuração o main.py recusa no boot
# (webhook que responde 200 e nunca devolve mensagem é pior que canal desligado).
# Os dois canais convivem: quem tem as duas identidades recebe proativo pelo
# CANAL_PREFERIDO — é assim que a família migra sem big-bang.
WHATSAPP_TOKEN=                  # System User, expiração "Nunca" (etapa 3)
WHATSAPP_PHONE_NUMBER_ID=        # id do número remetente, não o telefone (etapa 2)
WHATSAPP_APP_SECRET=             # assina o webhook: X-Hub-Signature-256 (etapa 4)
WHATSAPP_VERIFY_TOKEN=           # você inventa: openssl rand -hex 16 (etapa 5)
WHATSAPP_WABA_ID=                # conta WhatsApp Business (gerenciar templates)
# Versão da Graph API — a Meta descontinua a cada ~2 anos, confira no changelog
WHATSAPP_API_VERSION=v25.0
# Porta INTERNA do webhook (o Caddy do host faz o HTTPS e o reverse_proxy)
WHATSAPP_PORTA=8090
# Fora da janela de 24h só sai TEMPLATE aprovado, e template aprovado é imutável
# — mudou o texto, aprove lembrete_v2 e troque aqui. Vazio = proativo fora da
# janela não é enviado (fica só no log).
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_v1
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# Canal preferido para lembretes/briefing de quem tem os dois canais
CANAL_PREFERIDO=whatsapp

# ── Google Calendar (piloto; ver docs/google-calendar-piloto.md) ─────────
# As quatro variáveis trabalham juntas. Todas vazias = integração desligada,
# sem impedir o boot. O callback precisa bater exatamente com o Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mordomo.mvpsardenberg.cloud/integracoes/google/callback
# Gere com: uv run python -m mordomo.integracoes.cripto
GOOGLE_TOKEN_KEY=

# ── LLM via OpenRouter (uma chave, vários modelos) ───────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos (ids do OpenRouter — confira em https://openrouter.ai/models).
# Roteador barato + subagentes melhores. Alternativas comentadas.
MODEL_SUPERVISOR=anthropic/claude-haiku-4.5
MODEL_AGENTE=anthropic/claude-sonnet-4.5
# MODEL_SUPERVISOR=google/gemini-2.5-flash
# MODEL_AGENTE=openai/gpt-4o-mini
# Dica: escolha modelos com bom suporte a tool calling; o supervisor usa
# structured output e os subagentes usam tools — modelos "free" fracos falham aqui.

# ── Áudio (Groq/Whisper — grátis em https://console.groq.com/keys) ───────
# Vazio = bot recusa áudio com simpatia e todo o resto funciona. Com a chave,
# o adapter transcreve a voz e ela entra no MESMO pipeline do texto.
GROQ_API_KEY=
GROQ_MODELO_TRANSCRICAO=whisper-large-v3-turbo

# ── Banco (Postgres via docker compose up -d) ────────────────────────────
DATABASE_URL=postgresql+psycopg://mordomo:mordomo@localhost:5432/mordomo
# Senha do Postgres do compose. Vazio = "mordomo" (só aceitável em dev local).
# Na VPS: gere uma forte (openssl rand -base64 24), preencha aqui E ajuste a
# DATABASE_URL acima se você conecta de fora do compose. Banco já criado não
# troca de senha por variável — ver "Senha do banco" no docs/deploy-vps.md.
POSTGRES_PASSWORD=

# Criptografia dos backups (scripts/backup.*): o dump leva o COFRE da família
# em claro. Com a passphrase, sai .sql.gpg (AES256); vazio = texto puro com
# aviso. Guarde a passphrase FORA da máquina (gerenciador de senhas): backup
# que não abre é igual a não ter backup.
BACKUP_PASSPHRASE=

# ── Observabilidade (Langfuse Cloud tem plano grátis; ou self-host) ──────
# https://cloud.langfuse.com → Settings → API Keys. Vazio = desligado (o bot roda igual).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Latência do LLM (ver docs/adr/006-latencia-e-provedores.md) ──────────
# O OpenRouter serve o mesmo modelo a partir de hosts diferentes. Medimos p50 de
# 1,3s e um pico de 10,6s no mesmo prompt — abortar e repetir sai mais barato
# que esperar. Deixe OPENROUTER_PROVIDER_SORT vazio para não declarar preferência.
LLM_TIMEOUT_SEGUNDOS=8.0
LLM_MAX_RETRIES=2
# Prazo TOTAL de cada chamada ao LLM. Protege contra servidor que envia
# keep-alives e, por isso, nunca fica 8s inativo mesmo mantendo a chamada presa.
# Não envolve o grafo nem tools: operações mutantes nunca são canceladas aqui.
LLM_PRAZO_TOTAL_SEGUNDOS=15.0
OPENROUTER_PROVIDER_SORT=latency

# ── Contexto por chamada (ver docs/adr/007-janela-de-contexto.md) ────────
# Ao LLM vão só as últimas N mensagens; o histórico completo fica no
# checkpointer. Sem isso a entrada do supervisor crescia ~72 tokens/turno,
# para sempre. 0 = desligado.
CONTEXTO_JANELA_MENSAGENS=8

# ── Pedidos da família → issues no GitHub ────────────────────────────────
# Fine-grained PAT com Issues read/write no repo. Vazio = o pedido ainda é
# registrado em product_events; só a issue não nasce.
GITHUB_TOKEN=
GITHUB_REPO=HumbertoSar/mordomo
# O repo acima é PÚBLICO: por padrão a issue leva só o título curto; o texto
# original e o autor ficam em product_events. Só ligue o detalhe completo se
# apontar GITHUB_REPO para um repo PRIVADO.
GITHUB_ISSUES_DETALHADAS=false

# ── Ambiente ─────────────────────────────────────────────────────────────
# Tag dos traces no Langfuse: "dev" na sua máquina, "prod" na VPS.
AMBIENTE=dev

# ── Comportamento ────────────────────────────────────────────────────────
TZ_FAMILIA=America/Sao_Paulo
DEBOUNCE_SEGUNDOS=1.5
# Briefing matinal proativo (agenda + lembretes do dia). Vazio = desligado.
BRIEFING_HORA=07:30
# Curadoria de evals aos domingos (relatório + issue com casos propostos).
CURADORIA_HORA=18:30
